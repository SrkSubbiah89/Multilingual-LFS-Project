# PostgreSQL
DATABASE_URL=postgresql://lfs_user:lfs_password@localhost:5432/lfs_db
POSTGRES_DB=lfs_db
POSTGRES_USER=lfs_user
POSTGRES_PASSWORD=lfs_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama (local, free — used for all general/conversational tasks)
# Install: https://ollama.com  |  then: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic (Claude 3.5 Sonnet — used for critical tasks, and as the
# first hop in the GENERAL-task fallback chain below if Ollama is down)
ANTHROPIC_API_KEY=

# Gemini (Google AI Studio, free-tier hosted inference — strong at
# document understanding, long prompts, structured JSON extraction.
# Consulted whenever a caller explicitly pins reranker_model=
# "gemini/<model>", AND as a hop in get_llm(TaskType.GENERAL)'s
# automatic fallback chain (2026-08-24) if Ollama and Anthropic are both
# unavailable. Get a free key at aistudio.google.com/apikey — no credit
# card required. Free tier is ~20 requests/day for some models — see
# LLM_FALLBACK_EXCLUDE below if you want to keep that quota for
# deliberate use only.)
GEMINI_API_KEY=

# Groq (free-tier hosted inference — fast, on Groq's own hardware, not
# memory-constrained by this machine. Consulted when explicitly pinned
# via reranker_model="groq/<model>", and as a hop in the automatic
# GENERAL-task fallback chain. Get a free key at console.groq.com — no
# credit card required.)
GROQ_API_KEY=

# OpenRouter (permanent free model catalog, tighter per-model rate
# limits — useful for benchmarking several free open models without
# rewriting the LLM client. Consulted when explicitly pinned via
# reranker_model="openrouter/<model>", and as the last hop in the
# automatic GENERAL-task fallback chain. Get a free key at
# openrouter.ai/keys.)
OPENROUTER_API_KEY=

# GENERAL-task automatic fallback chain (2026-08-24): get_llm(TaskType.
# GENERAL) tries Ollama -> Anthropic -> Gemini -> Groq -> OpenRouter in
# order, stopping at the first provider that's actually configured. This
# is construction-time only (checks "is the API key set", not "does the
# account actually have credit/quota right now" -- that's only knowable
# by making a real call, which would burn quota just to check). If a
# configured provider is known to be unusable (e.g. zero account
# credit), list it here so the chain skips it outright instead of
# reaching it and failing later at actual inference time. Comma-
# separated, case-insensitive: ollama, anthropic, gemini, groq,
# openrouter.
LLM_FALLBACK_EXCLUDE=

# OpenAI (no longer used by default; kept for optional future use)
# OPENAI_API_KEY=

# OTP delivery — false = email only (SendGrid), true = SMS via Twilio (not implemented)
USE_SMS_OTP=false

# SendGrid (active — used for email OTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio (only required when USE_SMS_OTP=true — disabled for development/demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
