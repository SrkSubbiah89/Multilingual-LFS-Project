# PostgreSQL
DATABASE_URL=postgresql://lfs_user:lfs_password@localhost:5432/lfs_db
POSTGRES_DB=lfs_db
POSTGRES_USER=lfs_user
POSTGRES_PASSWORD=lfs_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama (local, free — used for all general/conversational tasks)
# Install: https://ollama.com  |  then: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic (Claude 3.5 Sonnet — used only for critical tasks)
ANTHROPIC_API_KEY=

# Gemini (Google AI Studio, free-tier hosted inference — recommended
# PRIMARY option for eval/thesis RAG-comparison work: strong at document
# understanding, long prompts, structured JSON extraction. Optional, only
# consulted when a caller explicitly pins reranker_model="gemini/<model>".
# Get a free key at aistudio.google.com/apikey — no credit card required.
# Not used by any default code path.)
GEMINI_API_KEY=

# Groq (free-tier hosted inference — fast fallback for eval/thesis RAG-
# comparison work on machines too memory-constrained to run larger Ollama
# models reliably. Optional, only consulted when a caller explicitly pins
# reranker_model="groq/<model>". Get a free key at console.groq.com — no
# credit card required. Not used by any default code path.)
GROQ_API_KEY=

# OpenRouter (permanent free model catalog, tighter rate limits — model-
# testing fallback for benchmarking several free open models without
# rewriting the LLM client. Optional, only consulted when a caller
# explicitly pins reranker_model="openrouter/<model>". Get a free key at
# openrouter.ai/keys. Not used by any default code path.)
OPENROUTER_API_KEY=

# OpenAI (no longer used by default; kept for optional future use)
# OPENAI_API_KEY=

# OTP delivery — false = email only (SendGrid), true = SMS via Twilio (not implemented)
USE_SMS_OTP=false

# SendGrid (active — used for email OTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio (only required when USE_SMS_OTP=true — disabled for development/demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
